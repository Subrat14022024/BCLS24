                field(Web; Rec.Web)
                {
                    ToolTip = 'Specifies the value of the Web field.', Comment = '%';
                }
            }
        }
    }
    actions
    {
        area(processing)
        {
            action(ImportCBECompanies)
            {
                Caption = 'Import CBE Companies';
                ApplicationArea = All;
                ToolTip = 'Imports companies from the CBE based on the search criteria.';
                Image = Import;
                trigger OnAction()
                var
                    CBEImporter: Codeunit "CBE Importer";
                begin
                    CBEImporter.Run();
                end;
            }
            action(DeteleAllData)
            {
                Caption = 'Delete All Data';
                ApplicationArea = All;
                ToolTip = 'Deletes all imported CBE company data.';
                Image = Delete;
                trigger OnAction()
                var
                    FSOCBEEstablishment: Record "FSO CBE Establishment";
                    FSOCBENACEActivity: Record "FSO CBE NACE Activity";
                begin
                    Rec.DeleteAll();
                    FSOCBEEstablishment.DeleteAll();
                    FSOCBENACEActivity.DeleteAll();
                end;
            }
        }
    }
    trigger OnDeleteRecord(): Boolean
    var
        FSOCBEEstablishment: Record "FSO CBE Establishment";
        FSOCBENACEActivity: Record "FSO CBE NACE Activity";
    begin
        FSOCBEEstablishment.SetRange("Company CBE No.", Rec."CBE No.");
        if FSOCBEEstablishment.FindSet() then
            FSOCBEEstablishment.DeleteAll();
        FSOCBENACEActivity.SetRange("Company CBE No.", Rec."CBE No.");
        if FSOCBENACEActivity.FindSet() then
            FSOCBENACEActivity.DeleteAll();
    end;
}
