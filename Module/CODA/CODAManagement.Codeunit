    local procedure ProcessStatement();
    var
        CodaBankStmt: Record 2000040;
        PostCodaStatementLines: Report 2000059;
    begin
        CodaBankStmt.SETRANGE("Bank Account No.", BankAccountNo);
        IF NoOfRecordInFile = 0 THEN
            NoOfRecordInFile := IdentifyNoOfRecordInFile(CODAFILE_Path + '\' + CODAFILE_Name);
        IF NoOfRecordInFile < 2 THEN
            CodaBankStmt.SETRANGE("Statement No.", StatementNo);
        PostCodaStatementLines.SETTABLEVIEW(CodaBankStmt);
        PostCodaStatementLines.USEREQUESTPAGE(FALSE);
        //PostCodaStatementLines.SetNoGUI(TRUE);
        PostCodaStatementLines.RUNMODAL;
    end;

    local procedure ReportError();
    begin
    end;

    local procedure TransferStatement();
    var
        CodaBankStmtLine: Record 2000041;
        PostCodedBankStatement: Codeunit 2000042;
        BankAccount: Record 270;
        RunInstance: Codeunit 50109;
        GenJnlBatch: Record "Gen. Journal Batch";
        BatchName: Code[10];
    begin
        CodaBankStmtLine.SETRANGE("Bank Account No.", BankAccountNo);
        CodaBankStmtLine.SETRANGE("Statement No.", StatementNo);
        //PostCodedBankStatement.SetNoGUI(TRUE);
        PostCodedBankStatement.RUN(CodaBankStmtLine);
        CodaBankStmtLine.RESET;
        //  HS 20190130 WAM14-0108 START
        BankAccount.GET(BankAccountNo);
        //IF BankAccount."Auto Post CODA Journals" THEN BEGIN
        GenJnlBatch.SETRANGE("Bal. Account Type", GenJnlBatch."Bal. Account Type"::"Bank Account");
        GenJnlBatch.SETRANGE("Bal. Account No.", BankAccountNo);
        //GenJnlBatch.SETRANGE(CODA, TRUE);
        //GenJnlBatch.SETRANGE(Name, "Bank Account No."+"Statement No.");
        BatchName := STRSUBSTNO('%1%2', COPYSTR(BankAccountNo, 1, 7), COPYSTR(StatementNo, 1, 3));
        GenJnlBatch.SETRANGE(Name, BatchName);
        IF GenJnlBatch.COUNT = 1 THEN BEGIN
            GenJnlBatch.FINDFIRST;
            CLEAR(RunInstance);
            RunInstance.SetNEXTSTEP('26');
            RunInstance.SetStep26Param(GenJnlBatch."Journal Template Name", GenJnlBatch.Name);
            COMMIT;
            IF NOT RunInstance.RUN THEN BEGIN

            END
        END;
        //END;
    end;

