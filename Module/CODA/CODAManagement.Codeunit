codeunit 50109 "CODA Management"
{
    trigger OnRun();
    begin
        CASE STEP2RUN OF
            '':
                OnRunCode();
            '10':
                ProcessNewFiles();
            '20':
                ImportArchiveProcessNewFiles();
            '21':
                ImportCODAFile();
            '22':
                ProcessStatement();
            '24':
                TransferStatement();
            '26':
                PostJournal();
        END;
    end;

    var
        STEP2RUN: Code[20];
        StatementNo: Code[20];
        BankAccountNo: Code[20];
        CODAFILE_Path: Text[250];
        CODAFILE_Name: Text[250];
        CODAFILE_DIR: Text[250];
        NoOfRecordInFile: Integer;
        EndOfEachRecInFile1: Integer;
        EndOfEachRecInFile2: Integer;
        EndOfEachRecInFile3: Integer;
        A: File;
        JournalTemplate: Code[10];
        JournalBatch: Code[10];

    local procedure OnRunCode();
    var
        RunInstance: Codeunit 50109;
    begin
        RunInstance.SetNEXTSTEP('10');
        IF NOT RunInstance.RUN() then;
        CLEAR(RunInstance);
        RunInstance.SetNEXTSTEP('20');
        IF NOT RunInstance.RUN() then;
        CLEAR(RunInstance);
    end;

    procedure SetNEXTSTEP(NextStep: Code[20]);
    begin
        STEP2RUN := NextStep;
    end;

    procedure SetStep21Param(pBankAccountNo: Code[20]; pCODAFILE_Path: Text[250]; pCODAFILE_Name: Text[250]; pCODAFILE_Dir: Text[250]);
    begin
        BankAccountNo := pBankAccountNo;
        CODAFILE_Path := pCODAFILE_Path;
        CODAFILE_Name := pCODAFILE_Name;
        CODAFILE_DIR := pCODAFILE_Dir;
    end;

    procedure SetStep22Param(pBankAccountNo: Code[20]; pStatementNo: Code[20]);
    begin
        BankAccountNo := pBankAccountNo;
        StatementNo := pStatementNo;
    end;

    procedure SetStep24Param(pBankAccountNo: Code[20]; pStatementNo: Code[20]);
    begin
        BankAccountNo := pBankAccountNo;
        StatementNo := pStatementNo;
    end;

    procedure SetStep26Param(pJournalTemplate: Code[10]; pJournalBatch: Code[10]);
    begin
        JournalTemplate := pJournalTemplate;
        JournalBatch := pJournalBatch;
    end;

