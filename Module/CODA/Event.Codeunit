    // This event subscriber handles the selection and assignment of the appropriate journal batch name
    // before showing the post result message. It checks if the batch is of type Financial and, depending
    // on the CODA flag and batch existence, assigns or increments the batch name to ensure correct posting.
    // The logic ensures that the correct batch is used for posting, especially when working with CODA batches,
    // and maintains the line number consistency for new or empty journal lines.

    [EventSubscriber(ObjectType::Codeunit, Codeunit::"Gen. Jnl.-Post", OnBeforeShowPostResultMessage, '', false, false)]
    local procedure "Gen. Jnl.-Post_OnBeforeShowPostResultMessage"(var GenJnlLine: Record "Gen. Journal Line"; TempJnlBatchName: Code[10]; var IsHandled: Boolean)
    var
        GeneralJournalBatch: Record "Gen. Journal Batch";
        GeneralJournalTemplate: Record "Gen. Journal Template";
        Memory: Codeunit Memory;
        IncrementedBatchName: code[20];
    begin

        if not Memory.Get() then
            exit;
        if GeneralJournalTemplate.Get(GenJnlLine."Journal Template Name") then
            if GeneralJournalTemplate.Type <> GeneralJournalTemplate.Type::Financial then
                exit;
        GeneralJournalBatch.Setrange("Template Type", GeneralJournalBatch."Template Type"::Financial);
        IncrementedBatchName := IncStr(GenJnlLine."Journal Batch Name");
        if GeneralJournalBatch.Get(GenJnlLine."Journal Template Name", IncrementedBatchName) then begin
            GeneralJournalBatch.SetRange(Name, IncrementedBatchName);
            GeneralJournalBatch.SetRange(CODA, true);
            if GeneralJournalBatch.FindFirst() then begin
                if GenJnlLine.IsEmpty then begin
                    GenJnlLine."Journal Batch Name" := GeneralJournalBatch.Name;
                    GeneralJournalBatch.Reset();
                    GeneralJournalBatch.SetRange(CODA, false);
                    if GeneralJournalBatch.FindFirst() then
                        if GenJnlLine.IsEmpty then begin
                            GenJnlLine."Journal Batch Name" := GeneralJournalBatch.Name;
                            GenJnlLine."Line No." := 1;
                        end;
                    GenJnlLine."Journal Batch Name" := GeneralJournalBatch.Name;
                    GenJnlLine."Line No." := 1;
                end;
                if GenJnlLine.IsEmpty then begin
                    GenJnlLine."Journal Batch Name" := GenJnlLine."Journal Batch Name"; // Keep original batch name
                    GenJnlLine."Line No." := 1;
                end;
            end;
        end;
    end;

