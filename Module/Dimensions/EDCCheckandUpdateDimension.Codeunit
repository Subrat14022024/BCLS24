codeunit 50110 "EDC Check and Update Dimension"
{
    [EventSubscriber(ObjectType::Codeunit, Codeunit::DimensionManagement, OnAfterGetRecDefaultDimIDProcedure, '', false, false)]
    local procedure EDCOnAfterGetRecDefaultDimIDProcedure(var GlobalDim2Code: Code[20]; var DefaultDimSetID: Integer)

    begin
        if GlobalDim2Code = '' then
            exit;

        UpdateDimension(GlobalDim2Code, DefaultDimSetID);
    end;

    [EventSubscriber(ObjectType::Codeunit, Codeunit::DimensionManagement, OnAfterValidateShortcutDimValues, '', false, false)]
    local procedure EDCOnAfterValidateShortcutDimValues(FieldNumber: Integer; var DimSetID: Integer; var ShortcutDimCode: Code[20])
    begin
        if (FieldNumber <> 2) or (ShortcutDimCode = '') then
            exit;

        UpdateDimension(ShortcutDimCode, DimSetID);
    end;

    local procedure UpdateDimension(RefrenceDim: Code[20]; var DimensionSetID: Integer)
    var
        DimensionSetEntry: Record "Dimension Set Entry";
        TempDimSetEntry: Record "Dimension Set Entry" temporary;
        DimensionManagement: Codeunit "DimensionManagement";
        RecordUpdated, RemoveDimension : Boolean;
        UpdateDimCode: Code[20];
    begin
        DimensionManagement.GetDimensionSet(TempDimSetEntry, DimensionSetID);

        RemoveDimension := CheckAndDecide(RefrenceDim, UpdateDimCode);
        RecordUpdated := UpdateRecord(TempDimSetEntry, UpdateDimCode, RemoveDimension);

        if RecordUpdated then
            DimensionSetID := DimensionSetEntry.GetDimensionSetID(TempDimSetEntry);
    end;

    local procedure CheckAndDecide(RefrenceDim: Code[20]; var UpdateDimCode: Code[20]) RemoveDimension: Boolean
    var
        DimensionValue: Record "Dimension Value";
    begin
        GeneralLedgerSetup.Get();
        DimensionValue.GET(GeneralLedgerSetup."Global Dimension 2 Code", RefrenceDim);
        UpdateDimCode := DimensionValue."Entity";
        if UpdateDimCode = '' then
            RemoveDimension := true;
    end;

    local procedure UpdateRecord(var TempDimSetEntry: Record "Dimension Set Entry" temporary; UpdateDimCode: Code[20]; RemoveDim: Boolean) RecordUpdated: Boolean
    begin
        TempDimSetEntry.SetRange("Dimension Code", GeneralLedgerSetup."Shortcut Dimension 5 Code");
        if TempDimSetEntry.IsEmpty then
            if RemoveDim then
                exit
            else
                RecordUpdated := AddorUpdateDimensionValue(TempDimSetEntry, UpdateDimCode)
        else begin
            TempDimSetEntry.SetRange("Dimension Value Code", UpdateDimCode);
            if TempDimSetEntry.IsEmpty then
                if RemoveDim then
                    RecordUpdated := RemoveDimensionValue(TempDimSetEntry)
                else
                    RecordUpdated := AddorUpdateDimensionValue(TempDimSetEntry, UpdateDimCode);
        end;
    end;

    local procedure AddorUpdateDimensionValue(var TempDimSetEntry: Record "Dimension Set Entry" temporary; UpdateDimCode: Code[20]): Boolean
    var
        Dimensionvalue: Record "Dimension Value";
    begin
        ResetDimensionSetID(TempDimSetEntry);

        Dimensionvalue.GET(GeneralLedgerSetup."Shortcut Dimension 5 Code", UpdateDimCode);
        if Dimensionvalue.Blocked then
            exit(false);

        if TempDimSetEntry.Get(0, GeneralLedgerSetup."Shortcut Dimension 5 Code") then begin
            TempDimSetEntry."Dimension Value Code" := UpdateDimCode;
            TempDimSetEntry."Dimension Value ID" := Dimensionvalue."Dimension Value ID";
            TempDimSetEntry.Modify();
        end else begin
            TempDimSetEntry."Dimension Code" := GeneralLedgerSetup."Shortcut Dimension 5 Code";
            TempDimSetEntry."Dimension Value Code" := UpdateDimCode;
            TempDimSetEntry."Dimension Value ID" := Dimensionvalue."Dimension Value ID";
            TempDimSetEntry.Insert();
        end;
        exit(true);
    end;

    local procedure RemoveDimensionValue(var TempDimSetEntry: Record "Dimension Set Entry" temporary): Boolean
    begin
        ResetDimensionSetID(TempDimSetEntry);
        if TempDimSetEntry.Get(0, GeneralLedgerSetup."Shortcut Dimension 5 Code") then
            TempDimSetEntry.Delete();
        exit(true);
    end;

    local procedure ResetDimensionSetID(var TempDimSetEntry: Record "Dimension Set Entry" temporary)
    begin
        TempDimSetEntry.SetRange("Dimension Code");
        TempDimSetEntry.SetRange("Dimension Value Code");
        if TempDimSetEntry.FindSet(true) then
            repeat
                TempDimSetEntry.Rename(0, TempDimSetEntry."Dimension Code");
            until TempDimSetEntry.Next() = 0;
    end;

    var
        GeneralLedgerSetup: Record "General Ledger Setup";
}