            { }
            column(DocumentNo; "Document No.")
            { }
            column(Vendor_Name; "Vendor Name")
            { }
            column(ExternalDocumentNo; "External Document No.")
            { }
            column(AmountLCY; "Amount (LCY)")
            { }
            column()
        }
        }
    }
